# Copy values into the server's private .env (or /etc/respace-reconstruction.env).
# The OpenAI key stays on the worker; never put it in the iOS app configuration.
RESPACE_RECONSTRUCTION_TOKEN=replace-with-a-random-token-of-at-least-16-characters
RESPACE_RECONSTRUCTION_DATA=./data
RESPACE_PIPELINE=walkthrough
RESPACE_ROOM_TIMEOUT_SECONDS=1800
# Legacy inspector only; walkthrough never calls Astra or Gemini.
RESPACE_SCENE_GENERATOR=measured
# Optional local/GPU completion adapter, as a JSON argv array. It accepts
# --request request.json --output completed.obj (metric object-local mesh).
RESPACE_OBJECT_COMPLETION_COMMAND=
OPENAI_API_KEY=
RESPACE_ASTRA_IMAGE_LIMIT=32
