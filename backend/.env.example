# Server-only configuration. Do not embed these credentials in the iOS app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/respace?sslmode=require
CAPTURE_BUCKET=PRIVATE_BUCKET_NAME
GOOGLE_CLOUD_PROJECT=PROJECT_ID
CLOUD_TASKS_LOCATION=REGION
CLOUD_TASKS_QUEUE=respace-continuations
WORKER_URL=https://WORKER_SERVICE.run.app
TASKS_SERVICE_ACCOUNT=respace-tasks@PROJECT_ID.iam.gserviceaccount.com
RESPACE_SERVICE_ROLE=api
RESPACE_ASSET_ROOT=/app/assets
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_PLANNING_MODEL=
GEMINI_EXTRACTION_MODEL=
GEMINI_SPATIAL_MODEL=
GEMINI_EDIT_MODEL=
PERCEPTRON_API_KEY=
PERCEPTRON_MODEL=perceptron-mk1.5
SERPAPI_API_KEY=
# Use workload identity/ADC in Cloud Run; do not ship service-account key files.
# Runtime IAM: secretAccessor on these secrets, objectUser on the private capture
# bucket, cloudtasks.enqueuer on the queue, serviceAccountUser on TASKS_SERVICE_ACCOUNT.
# Give TASKS_SERVICE_ACCOUNT and the Scheduler OIDC account run.invoker on worker
# only. Enable bucket uniform access and public-access prevention. Never grant
# allUsers access to the worker or the capture bucket.
# Recovery: authenticated Scheduler POST /internal/recover on WORKER_URL every minute.
# Database connections already require SSL and use at most five per instance.
# These are configuration templates; deployed termination/replay proof remains open.
