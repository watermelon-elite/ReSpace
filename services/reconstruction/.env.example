# Copy values into the local service's private .env.
# The OpenAI key stays on your Mac; never put it in the iOS app configuration.
RESPACE_RECONSTRUCTION_TOKEN=replace-with-a-random-token-of-at-least-16-characters
RESPACE_RECONSTRUCTION_DATA=./data
RESPACE_PIPELINE=threejs
RESPACE_ROOM_TIMEOUT_SECONDS=3600
# Three.js coding and comparison calls share a $10 token ceiling per generation.
OPENAI_API_KEY=
